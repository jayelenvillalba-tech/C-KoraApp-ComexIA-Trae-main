# =====================================================
# CHE.COMEX v2.0 - VARIABLES DE ENTORNO
# Copiar este archivo como .env y completar los valores
# NUNCA subir .env a GitHub (ya está en .gitignore)
# =====================================================

# SERVIDOR
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# BASE DE DATOS
DATABASE_URL=file:./comexia_v2.db
SQLITE_DB_PATH=./comexia_v2.db

# AUTENTICACION JWT
JWT_SECRET=comexia_secret_key_change_in_production

# GROQ (IA principal) - OBLIGATORIO para funciones de IA
# Obtener GRATIS en: https://console.groq.com
GROQ_API_KEY=gsk_COMPLETAR_AQUI

# OPENAI - OPCIONAL (fallback para IA)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-COMPLETAR_AQUI

# TIPO DE CAMBIO - PARA CALCULADORA DE COSTOS
# Obtener GRATIS en: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=COMPLETAR_AQUI

# SENDGRID (emails) - OPCIONAL para desarrollo local
# Obtener en: https://sendgrid.com
SENDGRID_API_KEY=SG.COMPLETAR_AQUI
SENDGRID_FROM_EMAIL=noreply@checomex.com
SENDGRID_FROM_NAME=Che.Comex

# GMAIL (alternativa a Sendgrid para emails)
GMAIL_USER=COMPLETAR_AQUI@gmail.com
GMAIL_APP_PASSWORD=COMPLETAR_AQUI

# ABLY (chat en tiempo real) - OPCIONAL para desarrollo
# Obtener GRATIS en: https://ably.com
ABLY_API_KEY=COMPLETAR_AQUI

# STRIPE (pagos internacionales) - OPCIONAL para desarrollo
# Obtener en: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_COMPLETAR_AQUI
STRIPE_WEBHOOK_SECRET=whsec_COMPLETAR_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_COMPLETAR_AQUI
STRIPE_PRICE_PRO_MONTHLY=price_COMPLETAR_AQUI
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_COMPLETAR_AQUI
STRIPE_PRICE_PARTNER_PRO=price_COMPLETAR_AQUI

# MERCADOPAGO (pagos LatAm) - OPCIONAL para desarrollo
# Obtener en: https://www.mercadopago.com/developers
MP_ACCESS_TOKEN=APP_USR-COMPLETAR_AQUI
MP_PUBLIC_KEY=APP_USR-COMPLETAR_AQUI

# N8N (automatizacion) - OPCIONAL
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678

# CLOUDFLARE R2 (backups) - OPCIONAL
R2_ACCOUNT_ID=COMPLETAR_AQUI
R2_ACCESS_KEY_ID=COMPLETAR_AQUI
R2_SECRET_ACCESS_KEY=COMPLETAR_AQUI
R2_BUCKET_NAME=checomex-backups

# FRONTEND
VITE_WS_PORT=5174
VITE_API_URL=http://localhost:3001

# =====================================================
# MINIMO PARA DESARROLLO LOCAL:
# Solo necesitas completar GROQ_API_KEY para que
# las funciones de IA funcionen. El resto son
# opcionales para testear localmente.
# =====================================================
